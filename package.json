{
  "name": "service-ekosystem",
  "description": "A suite of cloud services for geospatial platforms",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:service-geokoder": "pnpm --filter @kalisio/service-geokoder build",
    "build:service-k2": "pnpm --filter @kalisio/service-k2 build",
    "build:service-kapture": "pnpm --filter @kalisio/service-kapture build",
    "build:service-katalog": "pnpm --filter @kalisio/service-katalog build",
    "build:service-kfs": "pnpm --filter @kalisio/service-kfs build",
    "build:service-kross": "pnpm --filter @kalisio/service-kross build",
    "bump": "changeset version",
    "clear": "pnpm -r exec rimraf node_modules dist coverage",
    "docs:build": "pnpm --filter docs run build",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:prepare": "pnpm --filter './examples/*' build",
    "inspect": "pnpm knip",
    "lint": "pnpm -r lint",
    "lint:service-geokatcher": "pnpm --filter @kalisio/service-geokatcher lint",
    "lint:service-geokoder": "pnpm --filter @kalisio/service-geokoder lint",
    "lint:service-k2": "pnpm --filter @kalisio/service-k2 lint",
    "lint:service-kapture": "pnpm --filter @kalisio/service-kapture lint",
    "lint:service-katalog": "pnpm --filter @kalisio/service-katalog lint",
    "lint:service-kfs": "pnpm --filter @kalisio/service-kfs lint",
    "lint:service-kross": "pnpm --filter @kalisio/service-kross lint",
    "lint:service-trakkar": "pnpm --filter @kalisio/service-trakkar lint",
    "posttest": "pnpm lcov-result-merger --prepend-source-files 'packages/*/coverage/lcov.info' coverage/lcov.info",
    "prebump": "changeset",
    "prepare": "node scripts/prepare.mjs",
    "pretest": "mkdir -p coverage",
    "release:service-geokoder": "pnpm --filter @kalisio/service-geokoder release",
    "release:service-k2": "pnpm --filter @kalisio/service-k2 release",
    "release:service-kapture": "pnpm --filter @kalisio/service-kapture release",
    "release:service-katalog": "pnpm --filter @kalisio/service-katalog release",
    "release:service-kfs": "pnpm --filter @kalisio/service-kfs release",
    "release:service-kross": "pnpm --filter @kalisio/service-kross release",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:service-geokatcher": "pnpm --filter @kalisio/service-geokatcher test",
    "test:service-geokoder": "pnpm --filter @kalisio/service-geokoder test",
    "test:service-k2": "pnpm --filter @kalisio/service-k2 test",
    "test:service-kapture": "pnpm --filter @kalisio/service-kapture test",
    "test:service-katalog": "pnpm --filter @kalisio/service-katalog test",
    "test:service-kfs": "pnpm --filter @kalisio/service-kfs test",
    "test:service-kross": "pnpm --filter @kalisio/service-kross test",
    "test:service-trakkar": "pnpm --filter @kalisio/service-trakkar test"
  },
  "keywords": [
    "kalisio",
    "ekosystem",
    "service-geokatcher",
    "service-geokoder",
    "service-k2",
    "service-kapture",
    "service-katalog",
    "service-kfs",
    "service-trakkar"
  ],
  "author": {
    "name": "KALISIO",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio",
    "logo": "https://kalisio.github.io/kalisioscope/kalisio/kalisio-logo-light.svg"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/service-ekosystem.git"
  },
  "bugs": {
    "url": "https://github.com/kalisio/service-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/service-ekosystem#readme",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "is-docker": "catalog:",
    "knip": "catalog:",
    "lcov-result-merger": "catalog:",
    "lint-staged": "catalog:",
    "rimraf": "catalog:",
    "standard": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
