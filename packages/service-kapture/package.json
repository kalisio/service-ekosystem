{
  "name": "@kalisio/service-kapture",
  "description": "Capture Kano Snapshots as a Service",
  "version": "1.6.1",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/kapture:${IMAGE_TAG:-dev} --build-arg NODE_VERSION=${NODE_VERSION:-20} --build-arg DEBIAN_VERSION=${DEBIAN_VERSION:-bookworm} -f ./Dockerfile ../..",
    "dev": "node --watch src/bin.js",
    "lint": "standard --fix",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/service-kapture@1.6.1",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/service-kapture@1.6.1",
    "test": "bash -c 'source ../../../development/workspaces/services/services.sh service-kapture && export APP_URL=$APP_DEV_URL && export APP_JWT=$APP_DEV_JWT && vitest run --coverage'"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/service-ekosystem.git",
    "directory": "packages/service-kapture"
  },
  "bugs": {
    "url": "https://github.com/kalisio/service-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/service-ekosystem/tree/master/packages/service-kapture",
  "dependencies": {
    "@kalisio/common-core": "catalog:",
    "@kalisio/common-geospatial": "catalog:",
    "cors": "catalog:",
    "debug": "catalog:",
    "express": "catalog:",
    "lodash": "catalog:",
    "lodash-es": "catalog:",
    "mathjs": "catalog:",
    "moment": "catalog:",
    "puppeteer": "catalog:",
    "sanitize-html": "catalog:",
    "sift": "catalog:",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:"
  },
  "devDependencies": {
    "pixelmatch": "catalog:",
    "pngjs": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}