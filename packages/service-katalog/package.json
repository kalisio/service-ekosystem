{
  "name": "@kalisio/service-katalog",
  "description": "Catalog service for KDK-based applications",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/katalog:${IMAGE_TAG:-dev} --build-arg NODE_VERSION=${NODE_VERSION:-20} --build-arg DEBIAN_VERSION=${DEBIAN_VERSION:-bookworm} -f ./Dockerfile ../..",
    "dev": "node --conditions=development --watch src/main.js",
    "lint": "standard --fix",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/service-katalog@0.1.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/service-katalog@0.1.0",
    "test": "bash -c 'source ../../../development/workspaces/services/services.sh service-katalog && vitest run --coverage'"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/service-ekosystem.git",
    "directory": "packages/service-katalog"
  },
  "bugs": {
    "url": "https://github.com/kalisio/service-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/service-ekosystem/tree/main/packages/service-katalog",
  "dependencies": {
    "@feathersjs/authentication": "catalog:",
    "@feathersjs/configuration": "catalog:",
    "@feathersjs/errors": "catalog:",
    "@feathersjs/express": "catalog:",
    "@feathersjs/feathers": "catalog:",
    "@feathersjs/socketio": "catalog:",
    "@kalisio/feathers-distributed": "catalog:",
    "@kalisio/kdk-core-api": "link:../../../kdk-ekosystem/packages/kdk-core-api",
    "@kalisio/kdk-map-api": "link:../../../kdk-ekosystem/packages/kdk-map-api",
    "debug": "catalog:",
    "glob": "catalog:",
    "winston": "catalog:"
  },
  "engines": {
    "node": ">= 20"
  }
}