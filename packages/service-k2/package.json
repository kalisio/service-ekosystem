{
  "name": "@kalisio/service-k2",
  "description": "3D terrain server for Cesium tiles",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/k2:${IMAGE_TAG:-dev} --build-arg NODE_VERSION=${NODE_VERSION:-20} --build-arg DEBIAN_VERSION=${DEBIAN_VERSION:-bookworm} -f ./Dockerfile ../..",
    "dev": "node --watch src/main.js",
    "lint": "standard --fix",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/service-k2@0.1.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/service-k2@0.1.0",
    "test": "bash -c 'source ../../../development/workspaces/services/services.sh service-k2 && vitest run --coverage'"
  },
  "keywords": [
    "kalisio",
    "kargo",
    "cesium"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/service-ekosystem.git",
    "directory": "packages/service-k2"
  },
  "bugs": {
    "url": "https://github.com/kalisio/service-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/service-ekosystem/tree/master/packages/service-k2",
  "dependencies": {
    "@kalisio/common-geospatial": "catalog:",
    "@mapbox/mbtiles": "catalog:",
    "@turf/along": "catalog:",
    "@turf/helpers": "catalog:",
    "@turf/length": "catalog:",
    "@turf/meta": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "debug": "catalog:",
    "express": "catalog:",
    "geotiff": "catalog:",
    "lodash": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
