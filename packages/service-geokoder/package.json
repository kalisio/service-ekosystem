{
  "name": "@kalisio/service-geokoder",
  "description": "Lightweight geocoder service providing forward and reverse geocoding",
  "version": "2.0.0",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/geokoder:${IMAGE_TAG:-dev} --build-arg NODE_VERSION=${NODE_VERSION:-20} --build-arg DEBIAN_VERSION=${DEBIAN_VERSION:-bookworm} -f ./Dockerfile ../..",
    "dev": "node --conditions=development --watch src/main.js",
    "lint": "standard --fix",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/service-geokoder@1.5.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/service-geokoder@1.5.0",
    "test": "bash -c 'source ../../../development/workspaces/services/services.sh service-geokoder && vitest run --coverage'"
  },
  "keywords": [
    "kalisio",
    "geokoder",
    "geocoder",
    "openstreetmap",
    "ban",
    "mbtiles",
    "kano"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/service-ekosystem.git",
    "directory": "packages/service-geokoder"
  },
  "bugs": {
    "url": "https://github.com/kalisio/service-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/service-ekosystem/tree/master/packages/service-geokoder",
  "dependencies": {
    "@feathersjs/commons": "catalog:",
    "@feathersjs/configuration": "catalog:",
    "@feathersjs/express": "catalog:",
    "@feathersjs/errors": "catalog:",
    "@feathersjs/feathers": "catalog:",
    "@kalisio/feathers-distributed": "catalog:",
    "@kalisio/kdk-core-api": "link:../../../kdk-ekosystem/packages/kdk-core-api",
    "@kalisio/kdk-map-api": "link:../../../kdk-ekosystem/packages/kdk-map-api",
    "@mapbox/mbtiles": "catalog:",
    "@mapbox/vtquery": "catalog:",
    "@turf/distance": "catalog:",
    "@turf/point-to-line-distance": "catalog:",
    "@turf/point-to-polygon-distance": "catalog:",
    "cors": "catalog:",
    "debug": "catalog:",
    "feathers-hooks-common": "catalog:",
    "fs-extra": "catalog:",
    "glob": "catalog:",
    "lodash": "catalog:",
    "minimatch": "catalog:",
    "node-geocoder": "catalog:",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:",
    "zlib": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
