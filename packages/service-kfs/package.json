{
  "name": "@kalisio/service-kfs",
  "description": "Kalisio Features Services",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build -t ${KALISIO_DOCKERHUB_URL:-docker.io}/kalisio/kfs:${IMAGE_TAG:-dev} --build-arg NODE_VERSION=${NODE_VERSION:-20} --build-arg DEBIAN_VERSION=${DEBIAN_VERSION:-bookworm} -f ./Dockerfile ../..",
    "dev": "node --watch src/server.js",
    "lint": "standard --fix",
    "release": "git tag \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git tag @kalisio/service-kfs@0.1.0",
    "postrelease": "git push origin \"$(node -p \"const p=require('./package.json');p.name+'@'+p.version\")\" # e.g. git push origin @kalisio/service-kfs@0.1.0",
    "test": "bash -c 'source ../../../development/workspaces/services/services.sh kfs && export NODE_CONFIG_DIR=./test/config && vitest run --coverage'"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/service-ekosystem.git",
    "directory": "packages/service-kfs"
  },
  "bugs": {
    "url": "https://github.com/kalisio/service-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/service-ekosystem/tree/master/packages/service-kfs",
  "dependencies": {
    "@feathersjs/commons": "catalog:",
    "@feathersjs/configuration": "catalog:",
    "@feathersjs/errors": "catalog:",
    "@feathersjs/express": "catalog:",
    "@feathersjs/feathers": "catalog:",
    "@feathersjs/schema": "catalog:",
    "@kalisio/feathers-distributed": "catalog:",
    "@turf/helpers": "catalog:",
    "@turf/invariant": "catalog:",
    "compression": "catalog:",
    "is-docker":"catalog:",
    "cors": "catalog:",
    "debug": "catalog:",
    "envsub": "^4.0.7",
    "epsg-index": "catalog:",
    "feathers-hooks-common": "catalog:",
    "feathers-mongodb-fuzzy-search": "catalog:",
    "fs-extra": "catalog:",
    "helmet": "catalog:",
    "lodash": "catalog:",
    "moment": "catalog:",
    "reproject": "catalog:",
    "wellknown": "catalog:",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:"
  },
  "devDependencies": {
    "@feathersjs/memory": "catalog:",
    "@kalisio/kdk": "catalog:",
    "config": "catalog:",
    "cross-env": "catalog:",
    "sift": "catalog:",
    "superagent": "catalog:"
   },
  "engines": {
    "node": ">=20"
  }
}
