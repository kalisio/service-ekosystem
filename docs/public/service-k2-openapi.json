{
  "openapi": "3.0.3",
  "info": {
    "title": "service-k2",
    "description": "3D terrain server for Cesium tiles and terrain elevation computation",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Health",
      "description": "Service status"
    },
    {
      "name": "Terrain",
      "description": "Cesium quantized-mesh terrain tiles"
    },
    {
      "name": "Elevation",
      "description": "Terrain elevation computation"
    }
  ],
  "paths": {
    "/healthcheck": {
      "get": {
        "tags": ["Health"],
        "summary": "Service health check",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["isRunning"],
                  "properties": {
                    "isRunning": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/layer.json": {
      "get": {
        "tags": ["Terrain"],
        "summary": "Terrain layer metadata (single-file mode)",
        "description": "Returns the [Cesium quantized-mesh](https://github.com/CesiumGS/quantized-mesh) layer metadata for the single terrain file configured through `TERRAIN_FILEPATH`.",
        "operationId": "layerJson",
        "responses": {
          "200": {
            "description": "Layer metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayerMetadata"
                }
              }
            }
          },
          "404": {
            "description": "Metadata could not be read from the terrain file"
          }
        }
      }
    },
    "/{z}/{x}/{y}.terrain": {
      "get": {
        "tags": ["Terrain"],
        "summary": "Terrain tile (single-file mode)",
        "description": "Returns the gzipped quantized-mesh tile located at `z`/`x`/`y` from the single terrain file configured through `TERRAIN_FILEPATH`.",
        "operationId": "terrainTile",
        "parameters": [
          { "$ref": "#/components/parameters/Z" },
          { "$ref": "#/components/parameters/X" },
          { "$ref": "#/components/parameters/Y" }
        ],
        "responses": {
          "200": {
            "description": "A quantized-mesh tile (gzip encoded)",
            "headers": {
              "Content-Encoding": {
                "schema": { "type": "string", "example": "gzip" }
              }
            },
            "content": {
              "application/vnd.quantized-mesh": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": {
            "description": "Tile not found"
          }
        }
      }
    },
    "/{terrain}/layer.json": {
      "get": {
        "tags": ["Terrain"],
        "summary": "Terrain layer metadata (multi-file mode)",
        "description": "Returns the layer metadata for one of the terrain files served from the `TERRAIN_FOLDER` folder.",
        "operationId": "layerJsonNamed",
        "parameters": [
          { "$ref": "#/components/parameters/Terrain" }
        ],
        "responses": {
          "200": {
            "description": "Layer metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LayerMetadata" }
              }
            }
          },
          "404": {
            "description": "Metadata could not be read from the terrain file"
          }
        }
      }
    },
    "/{terrain}/{z}/{x}/{y}.terrain": {
      "get": {
        "tags": ["Terrain"],
        "summary": "Terrain tile (multi-file mode)",
        "description": "Returns the gzipped quantized-mesh tile located at `z`/`x`/`y` from one of the terrain files served from the `TERRAIN_FOLDER` folder.",
        "operationId": "terrainTileNamed",
        "parameters": [
          { "$ref": "#/components/parameters/Terrain" },
          { "$ref": "#/components/parameters/Z" },
          { "$ref": "#/components/parameters/X" },
          { "$ref": "#/components/parameters/Y" }
        ],
        "responses": {
          "200": {
            "description": "A quantized-mesh tile (gzip encoded)",
            "content": {
              "application/vnd.quantized-mesh": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": {
            "description": "Tile not found"
          }
        }
      }
    },
    "/elevation": {
      "post": {
        "tags": ["Elevation"],
        "summary": "Compute the elevation profile under a path",
        "operationId": "elevation",
        "description": "Computes the elevation of the terrain under a linear geographical element (a path/trajectory) from the available elevation data and a requested target resolution.\n\nBy default the elevation dataset is selected depending on the resolution:\n\n- `resolution < 250m`: SRTM v4,\n- `resolution < 500m`: GMTED 2010 — Maximum 7.5 arc-seconds grid,\n- `resolution < 1000m`: GMTED 2010 — Maximum 15 arc-seconds grid,\n- otherwise: GMTED 2010 — Maximum 30 arc-seconds grid.\n\n> When a GMTED dataset is selected the **maximum elevation** within each grid cell is returned, otherwise the **mean elevation** is returned.\n\nThe configuration properties below can be passed either as **query parameters** or as members of the posted GeoJSON. Any source sample with a `nodata` value is set to `0`.",
        "parameters": [
          {
            "name": "resolution",
            "in": "query",
            "required": false,
            "description": "Interval, in meters, between two elevation samples over the profile source. Values below `30` are clamped to `30`.",
            "schema": { "type": "integer", "minimum": 30, "default": 30 },
            "example": 1000
          },
          {
            "name": "concurrency",
            "in": "query",
            "required": false,
            "description": "How many segments are computed in parallel server side. Capped at `6`.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 6, "default": 4 }
          },
          {
            "name": "demOverride",
            "in": "query",
            "required": false,
            "description": "The name of an elevation dataset to use for custom datasets, resolved relative to `/mbtiles`. k2 auto-selects a dataset when empty.",
            "schema": { "type": "string", "default": "" }
          },
          {
            "name": "corridorWidth",
            "in": "query",
            "required": false,
            "description": "The width, in meters, of a corridor to consider around the path. The computed elevation is the max elevation of all the covered samples.",
            "schema": { "type": "number", "default": 0 }
          },
          {
            "name": "elevationOffset",
            "in": "query",
            "required": false,
            "description": "A constant offset, in meters, added to every computed elevation sample.",
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The GeoJSON used as elevation profile source. If a `FeatureCollection` is posted, only the first feature is used.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileSource" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A GeoJSON FeatureCollection of sampled points",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ElevationResult" }
              }
            }
          },
          "422": {
            "description": "Invalid GeoJSON",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvalidGeoJson" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Z": {
        "name": "z",
        "in": "path",
        "required": true,
        "description": "Tile zoom level",
        "schema": { "type": "integer" }
      },
      "X": {
        "name": "x",
        "in": "path",
        "required": true,
        "description": "Tile column",
        "schema": { "type": "integer" }
      },
      "Y": {
        "name": "y",
        "in": "path",
        "required": true,
        "description": "Tile row (TMS scheme)",
        "schema": { "type": "integer" }
      },
      "Terrain": {
        "name": "terrain",
        "in": "path",
        "required": true,
        "description": "Terrain file basename in lower case without the extension, e.g. `myterrain` for `/mbtiles/myterrain.mbtiles`.",
        "schema": { "type": "string" },
        "example": "myterrain"
      }
    },
    "schemas": {
      "LayerMetadata": {
        "type": "object",
        "description": "Cesium quantized-mesh layer metadata.",
        "properties": {
          "format": {
            "type": "string",
            "example": "quantized-mesh-1.0"
          },
          "scheme": {
            "type": "string",
            "example": "tms"
          },
          "tiles": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["{z}/{x}/{y}.terrain"]
          },
          "bounds": {
            "type": "array",
            "items": { "type": "number" },
            "example": [-180, -90, 180, 90]
          }
        },
        "additionalProperties": true
      },
      "ProfileSource": {
        "type": "object",
        "description": "A GeoJSON Feature (or FeatureCollection) whose geometry is the path to sample.",
        "required": ["type", "geometry"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Feature"]
          },
          "properties": {
            "type": "object",
            "description": "Optional configuration properties (resolution, concurrency, demOverride, corridorWidth, elevationOffset) may also be set here instead of as query parameters."
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["LineString"]
              },
              "coordinates": {
                "type": "array",
                "description": "Ordered [longitude, latitude] vertices of the path.",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "example": [[0.65, 43.1], [0.65, 42.2]]
              }
            }
          }
        }
      },
      "ElevationResult": {
        "type": "object",
        "required": ["type", "features"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["FeatureCollection"]
          },
          "features": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SamplePoint" }
          }
        }
      },
      "SamplePoint": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Feature"]
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Point"]
              },
              "coordinates": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2,
                "description": "[longitude, latitude]",
                "example": [0.65, 43.1]
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["z", "t"],
            "properties": {
              "z": {
                "type": "number",
                "description": "Computed elevation of the sampled point, including elevationOffset.",
                "example": 393
              },
              "t": {
                "type": "number",
                "description": "Curvilinear abscissa (distance along the path, in meters) of the sampled point.",
                "example": 0
              }
            }
          }
        }
      },
      "InvalidGeoJson": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid GeoJSON"
          },
          "errors": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
